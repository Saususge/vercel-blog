---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { HERO, SKILLS, PROJECTS } from "@/data/portfolio";
import { SITE } from "@/config";

const title = `Portfolio | ${SITE.title}`;
const description =
  "Saususge — Game Programmer 포트폴리오. ThorVG 오픈소스 기여, RayTracing, TinyEngine42D 등 GitHub 기반 프로젝트 큐레이션.";
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-10 sm:py-14">
      <p class="text-xs font-semibold tracking-[0.14em] text-accent uppercase">
        {HERO.eyebrow}
      </p>
      <h1
        class="mt-3 text-3xl leading-tight font-bold tracking-tight sm:text-4xl"
      >
        {HERO.title}
      </h1>
      <p class="mt-4 max-w-2xl text-[15px] leading-7 text-foreground/80">
        {HERO.desc}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={HERO.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-background hover:opacity-90"
        >
          {HERO.cta.label} ↗
        </a>
        <a
          href="mailto:saususge@gmail.com"
          class="inline-flex items-center rounded-full border border-border px-5 py-2.5 text-sm font-medium hover:border-accent hover:text-accent"
        >
          연락하기
        </a>
      </div>
      <p class="mt-3 text-xs text-foreground/60">
        채용 담당자용: 아래 3개 카드는 대표 작업만 큐레이션했습니다. 전체 활동은
        GitHub 프로필에서 확인하실 수 있습니다.
      </p>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="text-sm font-semibold tracking-wide text-foreground/70">
        Skills — 채용 담당자가 5초 안에 보는 키워드
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          SKILLS.map(s => (
            <li class="rounded-full border border-border bg-muted/40 px-3 py-2 text-xs leading-none">
              <span class="font-semibold">{s.label}</span>
              <span class="text-foreground/60"> · {s.note}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="py-8">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-bold tracking-tight">Featured Projects</h2>
        <a
          href="https://github.com/Saususge?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-accent hover:underline"
          >전체 GitHub 보기 ↗</a
        >
      </div>
      <p class="mt-2 text-sm text-foreground/70">
        ThorVG는 <span class="font-semibold text-foreground"
          >내가 기여한 내용만</span
        > 표기했습니다. (업스트림 전체가 아닌 포크 브랜치 기준)
      </p>

      <div class="mt-6 grid gap-5">
        {
          PROJECTS.map(p => (
            <article
              class:list={[
                "rounded-2xl border bg-card p-6 shadow-sm",
                p.featured
                  ? "border-accent/30 bg-accent/[0.04]"
                  : "border-border",
              ]}
            >
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class:list={[
                    "rounded-full px-2.5 py-1 text-[11px] font-bold tracking-wide uppercase",
                    p.featured
                      ? "bg-accent text-background"
                      : "bg-muted text-foreground/70 border border-border",
                  ]}
                >
                  {p.badge}
                </span>
                {p.featured && (
                  <span class="text-xs font-medium text-accent">
                    ★ 채용 담당자 추천 — 먼저 보세요
                  </span>
                )}
              </div>
              <h3 class="mt-3 text-lg font-bold leading-snug">{p.title}</h3>
              <p class="mt-2 text-sm leading-6 text-foreground/75">
                {p.summary}
              </p>
              <p class="mt-3 text-xs">
                <span class="font-semibold">역할:</span> {p.role}
                <span class="mx-1.5 text-foreground/30">·</span>
                <span class="font-semibold">스택:</span> {p.tech.join(" · ")}
              </p>
              <ul class="mt-3 list-disc space-y-1 ps-5 text-sm leading-6 text-foreground/80">
                {p.highlights.map(h => (
                  <li>{h}</li>
                ))}
              </ul>
              <div class="mt-4 flex flex-wrap gap-2">
                {p.links.map(l => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center rounded-full border border-border px-3 py-1.5 text-xs font-medium hover:border-accent hover:text-accent"
                  >
                    {l.label} ↗
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="rounded-2xl border border-border bg-muted/30 p-6">
      <h2 class="text-sm font-bold tracking-wide">GitHub 활동 한눈에</h2>
      <p class="mt-1 text-xs leading-5 text-foreground/60">
        빌드 시 API 호출 없이도 보이도록 정적 이미지로 표시합니다. (Vercel
        빌드에서 GitHub API 레이트리밋 이슈 방지)
      </p>
      <div class="mt-4 overflow-hidden rounded-xl border border-border bg-background">
        <img
          src="https://ghchart.rshah.org/Saususge"
          alt="Saususge GitHub contributions chart"
          loading="lazy"
          class="w-full"
        />
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href="https://github.com/Saususge"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-accent hover:underline"
          >github.com/Saususge ↗</a
        >
        <span class="text-xs text-foreground/40">·</span>
        <a href="/about" class="text-xs font-medium hover:text-accent"
          >About 페이지</a
        >
        <span class="text-xs text-foreground/40">·</span>
        <a href="/posts" class="text-xs font-medium hover:text-accent"
          >기술 글 보기</a
        >
      </div>
    </section>

    <div class="h-10"></div>
  </main>
  <Footer />
</Layout>
